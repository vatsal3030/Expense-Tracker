# =============================================================================
# Owino / FairShare — Production Environment Variables Template
# Copy this file to .env.production and provide real secrets prior to running:
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# =============================================================================

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&sslmode=require&connect_timeout=15&pool_timeout=15
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase Auth & Storage API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# Backend JWT Secret
JWT_SECRET=[YOUR_SECURE_RANDOM_JWT_SECRET]

# Distributed Cache
REDIS_URL=redis://redis:6379

# Client Build Arguments
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
NEXT_PUBLIC_API_URL=/api
